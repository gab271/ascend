# ────────────────────────────────────────────────────────────
# ASCEND — Environment Variables
# Copy this file to .env and fill in your Supabase credentials.
# NEVER commit .env to version control.
# ────────────────────────────────────────────────────────────

# Supabase project URL  (Settings → API → Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase anon/public key  (Settings → API → anon public)
# Safe to expose in the browser — RLS policies and RPCs protect all data.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
